---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SetImgKB — Compress Images to Exact KB Size',
  description = 'Deterministic in-browser image compression for government portals, exams, and web uploads. Set exact KB targets like 20 KB, 50 KB, or 100 KB. Zero cloud uploads.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://setimgkb.com');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SetImgKB',
  url: 'https://setimgkb.com',
  description: 'Client-side image compression utility that locks output files to an exact KB ceiling. Used for government portals, exam uploads, and web forms.',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any (browser-based)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Exact KB ceiling targeting (e.g., 19.0–19.6 KB for 20 KB target)',
    'Zero server uploads — 100% in-browser processing',
    'Supports JPEG, PNG, WebP up to 25 MB input',
    'Signature enhancement mode for scanned documents',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="SetImgKB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Dark mode: no-flash inline script runs before paint -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          theme === 'dark' ? '#090d16' : '#ffffff'
        );
      })();
    </script>
  </head>
  <body class="bg-white text-slate-900">
    <slot />
  </body>
</html>

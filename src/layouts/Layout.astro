---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = 'Resize Image to 20KB, 50KB & 100KB Online – SetImgKB',
  description = 'Free deterministic client-side image resizer. Lock photos and signatures strictly under 20KB, 50KB, or 100KB for SSC, UPSC, and online job portals without quality loss.',
  keywords = 'resize image to 20kb, resize image to 50kb, compress image to 100kb, pan card photo resizer, ssc photo resizer under 20kb, upsc signature resizer, image compressor to exact kb, reduce image size in kb',
} = Astro.props;

const canonicalURL = 'https://setimgkb.com/';

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SetImgKB',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  url: 'https://setimgkb.com/',
  description: 'Deterministic client-side image optimizer to compress photos and signatures to exact KB ceilings for exam and government portals.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How accurate is the KB targeting?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SetImgKB uses a binary-search quality algorithm that converges in 10–12 iterations. The output is guaranteed to land in [target × 0.95, target × 0.98]. For a 20 KB target, this means 19.0 KB to 19.6 KB — well within portal tolerance. The exact byte size displayed before download is always accurate.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is my image uploaded to any server?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "No. Every step — file reading, canvas downscaling, JPEG re-encoding, and the final download — happens entirely in your browser's memory using native Web APIs (Canvas2D, OffscreenCanvas, Web Workers). Nothing is transmitted over the network. Verify by opening DevTools → Network while using the tool: zero requests are made after page load.",
      },
    },
    {
      '@type': 'Question',
      name: 'Does image quality drop significantly at very low KB targets?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For very tight targets like 20 KB, the engine proportionally downscales (max 600×800 px) then optimizes JPEG quality within those dimensions. Results are visually acceptable for passport-sized government ID photos. For document scans, enabling "Signature Enhancement" boosts dark ink contrast and normalises paper to pure white — often yielding better legibility at small sizes.',
      },
    },
    {
      '@type': 'Question',
      name: 'My portal is still rejecting my file — what should I check?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Three common reasons beyond file size: (1) Dimension mismatch — some portals enforce specific pixel dimensions (e.g., exactly 100×120 px for SSC). Check the portal's exact specification. (2) File type — SetImgKB always outputs JPEG. If the portal requires PNG, it cannot be used for that step. (3) DPI metadata — a small number of portals scan embedded DPI; SetImgKB outputs standard 72 DPI which is accepted by all portals tested.",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://setimgkb.com/" />
    <meta property="og:title" content="Resize Image to 20KB, 50KB & 100KB Online – SetImgKB" />
    <meta property="og:description" content="Deterministic in-browser image compression. Lock files strictly within government portal limits (19.0 KB–19.6 KB) with zero server uploads." />
    <meta property="og:image" content="https://setimgkb.com/og-image.png" />
    <meta property="og:site_name" content="SetImgKB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Resize Image to 20KB, 50KB & 100KB Online – SetImgKB" />
    <meta name="twitter:description" content="Lock images and signatures strictly under 20KB or 50KB. Zero server upload, zero data leaks." />
    <meta name="twitter:image" content="https://setimgkb.com/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Dark mode: no-flash inline script runs before paint -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          theme === 'dark' ? '#090d16' : '#ffffff'
        );
      })();
    </script>
  </head>
  <body class="bg-white text-slate-900">
    <slot />
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CompressionStudio from '../components/CompressionStudio.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PortalTable from '../components/PortalTable.astro';
import SeoGuide from '../components/SeoGuide.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Resize Image to 20KB, 50KB & 100KB Online – SetImgKB"
  description="Compress images to exact target KB size (20KB, 50KB, 100KB) directly in your browser. Fast, secure, and portal-ready with zero server uploads."
>
  <Header />

  <main class="w-full min-h-screen bg-white dark:bg-slate-950 flex flex-col items-center overflow-x-hidden">

    <!-- Hero & Dropzone: Keep Intact -->
    <section class="w-full max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-6 flex flex-col items-center text-center" aria-label="Hero">
      <!-- Badge Pill -->
      <div class="mb-4">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse" aria-hidden="true"></span>
          In-Browser Binary Search Engine · Zero Server Uploads
        </span>
      </div>

      <!-- H1 Headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
        Lock Images to Exact <span class="text-blue-600">KB</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Deterministic in-browser compression for government portals, exams,
        and identity uploads. Set your target ceiling — output guaranteed within safety margins.
      </p>

      <!-- SSC Resizer Discoverability Banner Pill -->
      <div class="mt-4 mb-2">
        <a
          href="/ssc-photo-signature-resizer"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium bg-blue-50/90 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/80 dark:border-blue-800/80 hover:bg-blue-100 dark:hover:bg-blue-900/60 hover:border-blue-300 dark:hover:border-blue-700 transition-all shadow-2xs group"
        >
          <span>⚡ Preparing for competitive exams? Try our instant</span>
          <span class="font-bold underline decoration-blue-400 dark:decoration-blue-500 underline-offset-2 group-hover:text-blue-800 dark:group-hover:text-blue-200">SSC Photo &amp; Signature Resizer &rarr;</span>
        </a>
      </div>

      <!-- Compression Studio Dropzone Card -->
      <div id="studio" class="w-full text-left mt-4">
        <CompressionStudio />
      </div>
    </section>

    <!-- Workflow / How It Works -->
    <section id="how-it-works" class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-10">
      <HowItWorks />
    </section>

    <!-- Portal Specifications Table -->
    <section id="portal-specs" class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-10">
      <PortalTable />
    </section>

    <!-- SEO Guide Article -->
    <section class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-10 border-t border-slate-100 dark:border-slate-800">
      <SeoGuide />
    </section>

    <!-- FAQs -->
    <section id="faq" class="w-full max-w-3xl mx-auto px-4 sm:px-6 py-10 border-t border-slate-100 dark:border-slate-800">
      <FAQ />
    </section>

  </main>

  <Footer />
</Layout>

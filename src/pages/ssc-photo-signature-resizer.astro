---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SscResizerStudio from '../components/SscResizerStudio.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "SSC CHSL Photo & Signature Resizer (20KB - 50KB) Online — SetImgKB";
const pageDescription = "Resize and compress SSC CHSL photo (20KB-50KB, 3.5x4.5cm) and signature (10KB-20KB, 140x60px) strictly to official notification guidelines. 100% client-side.";
const pageKeywords = "ssc chsl photo resizer, ssc signature resizer 10 to 20 kb, ssc photo resize 20 to 50 kb, ssc chsl signature size, ssc cgl photo resizer, ssc photo resizer 3.5 x 4.5 cm, ssc signature size 140x60, ssc photo compressor online, ssc photo size converter";
const canonicalURL = "https://setimgkb.com/ssc-photo-signature-resizer";

const sscFaqSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://setimgkb.com/ssc-photo-signature-resizer#app',
      url: canonicalURL,
      name: 'SSC CHSL Photo & Signature Resizer',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires HTML5 Canvas and modern browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description: 'Dedicated client-side resizer and compressor for Staff Selection Commission (SSC CHSL, CGL, MTS, GD) photo and signature uploads.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://setimgkb.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'SSC Photo & Signature Resizer',
          item: canonicalURL,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://setimgkb.com/ssc-photo-signature-resizer#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the official photo size and dimension for SSC CHSL 2026?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'According to the official Staff Selection Commission notification, the candidate passport photograph must have a file size between 20 KB and 50 KB in JPEG/JPG format. Dimensions must be 3.5 cm (width) × 4.5 cm (height), equivalent to 413 × 531 pixels at 300 DPI. The background must be light or plain white without caps or dark glasses.',
          },
        },
        {
          '@type': 'Question',
          name: 'What are the signature specifications for the SSC portal?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The candidate signature must be between 10 KB and 20 KB in JPEG/JPG format. The dimension requirement is 140 pixels width × 60 pixels height (or 4.0 cm × 2.0 cm). The signature must be penned in black or dark blue ink on white unruled paper and must not be in running capital letters.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why does the SSC portal say "Dimensions not matched" or "File size exceeds limit"?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Smartphone photos frequently include hidden EXIF metadata (camera model, GPS data, colour profile chunks) adding 20–40 KB of header bloat that causes portal parsers to reject the file. Furthermore, non-deterministic compression tools often export files slightly above the 50 KB or 20 KB ceiling. SetImgKB strips all EXIF metadata and mathematically converges strictly within a safe 95%–98% corridor below the ceiling.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are glasses, spectacles, or caps permitted in the SSC photo upload?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No caps, hats, goggles, or spectacles with tinted or reflective lenses are permitted. If you wear regular clear prescription spectacles, ensure there is zero flash reflection or glare obscuring the pupils. Both ears and the full facial oval must remain clearly visible.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are my personal documents or signatures uploaded to any server?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Never. SetImgKB operates with a zero-server upload architecture. All image resizing, downsampling, and JPEG encoding take place 100% inside your local web browser memory using HTML5 Canvas. No image data is ever transmitted across the internet.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalURL}
  schema={sscFaqSchema}
>
  <Header />

  <main class="w-full min-h-screen bg-white dark:bg-slate-950 flex flex-col items-center overflow-x-hidden">

    <!-- Hero & Tool Workspace Section -->
    <section class="w-full max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-10 flex flex-col items-center text-center" aria-label="SSC CHSL Resizer Tool">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400 mb-6 self-start sm:self-center" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span class="text-slate-500 dark:text-slate-400">Portal Tools</span>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span class="text-slate-900 dark:text-white font-semibold">SSC CHSL Resizer</span>
      </nav>

      <!-- Badge Pill -->
      <div class="mb-4">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/70 text-blue-700 dark:text-blue-300 border border-blue-200/80 dark:border-blue-800 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse" aria-hidden="true"></span>
          SSC CHSL &amp; CGL 2026 Notification Calibrated

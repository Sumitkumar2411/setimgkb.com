---
// Header.astro — Centered Navbar with High-Discoverability Tools Dropdown
---

<header class="w-full border-b border-slate-200/80 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 text-slate-900 dark:text-white font-extrabold text-xl tracking-tight">
      <img src="/logo.png" alt="SetImgKB" class="w-8 h-8 shrink-0 object-contain rounded-lg" />
      SetImgKB
    </a>

    <!-- Nav Links & Badge -->
    <div class="flex items-center gap-4 sm:gap-6">
      <nav class="hidden md:flex items-center gap-5 text-sm font-semibold text-slate-600 dark:text-slate-300">
        
        <!-- Tools Dropdown (Matching AI TubeKit Pattern) -->
        <div class="relative group" id="tools-dropdown">
          <button
            type="button"
            id="tools-btn"
            class="flex items-center gap-1.5 py-1.5 px-2.5 rounded-lg hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors font-semibold cursor-pointer select-none"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Tools</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Dropdown Menu Card -->
          <div
            id="tools-menu"
            class="absolute left-0 top-full mt-1.5 w-76 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xl p-2.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50"
            role="menu"
          >
            <!-- Section: Govt & Portal Presets -->
            <div class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
              Govt &amp; Portal Presets
            </div>
            <a
              href="/ssc-photo-signature-resizer"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-blue-50/70 dark:hover:bg-blue-950/40 text-slate-900 dark:text-white transition-colors group/item"
              role="menuitem"
            >
              <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-900 dark:text-white">SSC CHSL Photo &amp; Signature</span>
                  <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">SSC</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">
                  3.5x4.5cm, 20-50KB compliant
                </p>
              </div>
            </a>

            <div class="my-1.5 border-t border-slate-100 dark:border-slate-800/80"></div>

            <!-- Section: Core Utilities -->
            <div class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
              Core Utilities
            </div>
            <a
              href="/"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/60 text-slate-900 dark:text-white transition-colors group/item"
              role="menuitem"
            >
              <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0 group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="9" y1="3" x2="9" y2="21"></line>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-bold text-slate-900 dark:text-white block">Exact KB Lock Engine</span>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">
                  Lock images to 20KB, 50KB &amp; 100KB
                </p>
              </div>
            </a>
            <a
              href="/resize-image-to-20kb"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/60 text-slate-900 dark:text-white transition-colors group/item"
              role="menuitem"
            >
              <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-900 dark:text-white">Resize Image to 20KB</span>
                  <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">20 KB</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">
                  Strict &lt;20KB for SSC, UPSC &amp; exam forms
                </p>
              </div>
            </a>
            <a
              href="/resize-image-to-50kb"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/60 text-slate-900 dark:text-white transition-colors group/item"
              role="menuitem"
            >
              <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-900 dark:text-white">Resize Image to 50KB</span>
                  <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300">50 KB</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">
                  Lock JPG/PNG strictly under 50KB
                </p>
              </div>
            </a>
          </div>
        </div>

        <a href="/#how-it-works" class="hover:text-slate-900 dark:hover:text-white transition-colors">How it works</a>
        <a href="/#portal-specs" class="hover:text-slate-900 dark:hover:text-white transition-colors">Portal specs</a>
        <a href="/#faq" class="hover:text-slate-900 dark:hover:text-white transition-colors">FAQ</a>
      </nav>

      <!-- Badge -->
      <div class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero server uploads
      </div>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer"
        aria-label="Toggle dark/light mode"
        type="button"
      >
        <!-- Sun (shown in dark mode) -->
        <svg class="icon-sun hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon (shown in light mode) -->
        <svg class="icon-moon block dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Mobile Menu Toggle Button (Visible on mobile) -->
      <button
        id="mobile-menu-btn"
        class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-full border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        type="button"
      >
        <svg id="mobile-icon-bars" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="mobile-icon-close" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-nav" class="hidden md:hidden border-t border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-950 px-4 pt-3 pb-6 space-y-3">
    <!-- Section: Govt & Portal Presets -->
    <div>
      <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Govt &amp; Portal Presets
      </div>
      <a
        href="/ssc-photo-signature-resizer"
        class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-blue-50/70 dark:hover:bg-blue-950/40 text-slate-900 dark:text-white transition-colors"
      >
        <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold text-slate-900 dark:text-white">SSC CHSL Photo &amp; Signature</span>
            <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">SSC</span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">3.5x4.5cm, 20-50KB compliant</p>
        </div>
      </a>
    </div>

    <!-- Section: Core Utilities -->
    <div>
      <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Core Utilities
      </div>
      <a
        href="/"
        class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-900 dark:text-white transition-colors"
      >
        <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="9" y1="3" x2="9" y2="21"></line>
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-slate-900 dark:text-white">Exact KB Lock Engine</span>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Lock images to 20KB, 50KB &amp; 100KB</p>
        </div>
      </a>
      <a
        href="/resize-image-to-20kb"
        class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-900 dark:text-white transition-colors"
      >
        <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold text-slate-900 dark:text-white">Resize Image to 20KB</span>
            <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">20 KB</span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Strict &lt;20KB for SSC, UPSC &amp; exam forms</p>
        </div>
      </a>
      <a
        href="/resize-image-to-50kb"
        class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-900 dark:text-white transition-colors"
      >
        <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold text-slate-900 dark:text-white">Resize Image to 50KB</span>
            <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300">50 KB</span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Lock JPG/PNG strictly under 50KB</p>
        </div>
      </a>
    </div>

    <!-- General Anchor Links -->
    <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex flex-col space-y-2 text-sm font-semibold text-slate-600 dark:text-slate-300 px-2">
      <a href="/#how-it-works" class="hover:text-blue-600 dark:hover:text-blue-400 py-1 transition-colors">How it works</a>
      <a href="/#portal-specs" class="hover:text-blue-600 dark:hover:text-blue-400 py-1 transition-colors">Portal specs</a>
      <a href="/#faq" class="hover:text-blue-600 dark:hover:text-blue-400 py-1 transition-colors">FAQ</a>
    </div>
  </div>
</header>

<script>
  // Theme Toggle
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') ?? 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      'content',
      next === 'dark' ? '#0a0b0d' : '#ffffff'
    );
  });

  // Mobile Menu Toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const iconBars = document.getElementById('mobile-icon-bars');
  const iconClose = document.getElementById('mobile-icon-close');

  mobileBtn?.addEventListener('click', () => {
    const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
    mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
    mobileNav?.classList.toggle('hidden');
    iconBars?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Desktop Tools Dropdown Click Toggle (for touch/click interactions)
  const toolsBtn = document.getElementById('tools-btn');
  const toolsMenu = document.getElementById('tools-menu');

  toolsBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = toolsBtn.getAttribute('aria-expanded') === 'true';
    toolsBtn.setAttribute('aria-expanded', String(!isExpanded));
    toolsMenu?.classList.toggle('opacity-100');
    toolsMenu?.classList.toggle('visible');
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('tools-dropdown')?.contains(e.target as Node)) {
      toolsBtn?.setAttribute('aria-expanded', 'false');
      toolsMenu?.classList.remove('opacity-100', 'visible');
    }
  });
</script>

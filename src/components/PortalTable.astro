---
// PortalTable.astro — Coinbase Data Surface Specification
// Centered section layout, 24px container radius, pill badges, and hairline borders.
const portals = [
  { portal: 'SSC CGL / CHSL',     format: 'JPG', maxSize: '20 KB',  dimensions: '100 × 120 px',  notes: 'Photo; white background',         targetKB: 20  },
  { portal: 'SSC (Signature)',     format: 'JPG', maxSize: '12 KB',  dimensions: '140 × 60 px',   notes: 'Signature on white',               targetKB: 12  },
  { portal: 'UPSC IAS / IPS',     format: 'JPG', maxSize: '40 KB',  dimensions: '400 × 300 px',  notes: 'Formal attire, light bg',          targetKB: 40  },
  { portal: 'NSDL PAN Card',      format: 'JPG', maxSize: '50 KB',  dimensions: '200 × 230 px',  notes: 'Colour photo',                     targetKB: 50  },
  { portal: 'State PSC (General)',format: 'JPG', maxSize: '100 KB', dimensions: '300 × 400 px',  notes: 'Varies by state',                  targetKB: 100 },
  { portal: 'Railway RRB / RRC',  format: 'JPG', maxSize: '50 KB',  dimensions: '200 × 230 px',  notes: 'Plain white background',           targetKB: 50  },
  { portal: 'NTA (NEET / JEE)',   format: 'JPG', maxSize: '200 KB', dimensions: '3.5 × 4.5 cm',  notes: 'High quality, light bg',           targetKB: 200 },
  { portal: 'IBPS Bank Exams',    format: 'JPG', maxSize: '50 KB',  dimensions: '200 × 230 px',  notes: 'Formal, plain bg',                 targetKB: 50  },
];
---

<div class="w-full max-w-4xl mx-auto" aria-labelledby="portal-heading">

    <!-- Centered Section Header (Fixes left-aligned text bleed) -->
    <div class="section-header">
      <span class="mono-eyebrow">Institutional Specifications</span>
      <h2 class="display-md" id="portal-heading">Government &amp; Exam Portal Limits</h2>
      <p class="body-lg">
        Official image size limits for recruitment commissions and statutory portals.
        Always verify against the latest official notification.
      </p>
    </div>

    <!-- Coinbase Table Container (24px Radius) -->
    <div class="table-outer">
      <table class="portal-table" role="table" aria-label="Portal image specifications">
        <thead>
          <tr class="table-head-row">
            <th scope="col" class="th">Portal / Commission</th>
            <th scope="col" class="th">Format</th>
            <th scope="col" class="th">Max Size</th>
            <th scope="col" class="th">Dimensions</th>
            <th scope="col" class="th">Portal Notes</th>
            <th scope="col" class="th th--action">Quick Preset</th>
          </tr>
        </thead>
        <tbody>
          {portals.map((row) => (
            <tr class="tr">
              <td class="td td--portal">{row.portal}</td>
              <td class="td td--format">
                <span class="badge-pill format-tag">{row.format}</span>
              </td>
              <td class="td">
                <span class="number-display size-text">{row.maxSize}</span>
              </td>
              <td class="td td--dims">{row.dimensions}</td>
              <td class="td td--notes">{row.notes}</td>
              <td class="td td--action">
                <a
                  href="#studio"
                  class="btn-sm quick-set-btn"
                  data-kb={row.targetKB}
                  aria-label={`Set target to ${row.maxSize} for ${row.portal}`}
                >
                  Set {row.maxSize}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="disclaimer">
      * Dimensions and size limits are verified benchmarks and may vary across annual recruitment cycles.
      Refer to your official examination portal for final guidelines.
    </p>

</div>

<style>
  /* Centered Section Header */
  .section-header {
    max-width: 720px;
    margin: 0 auto 56px auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .section-header .display-md {
    font-size: clamp(26px, 3.8vw, 38px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.8px;
    color: var(--color-ink);
  }

  .section-header .body-lg {
    max-width: 580px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-body);
  }

  /* Coinbase Table Container */
  .table-outer {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface-card);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .portal-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 720px;
  }

  /* Head */
  .table-head-row {
    background-color: var(--color-surface-strong);
    border-bottom: 1px solid var(--color-hairline);
  }

  .th {
    padding: 16px 20px;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-body);
    white-space: nowrap;
  }

  .th--action {
    text-align: right;
  }

  /* Body rows */
  .tr {
    background-color: var(--color-surface-card);
    transition: background-color 0.15s ease;
  }

  .tr:hover {
    background-color: var(--color-hover-bg);
  }

  .td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-ink);
    font-size: 14px;
    vertical-align: middle;
  }

  .tr:last-child .td {
    border-bottom: none;
  }

  .td--portal {
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .td--dims {
    white-space: nowrap;
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .td--notes {
    color: var(--color-body);
    font-size: 13px;
  }

  .td--action {
    text-align: right;
  }

  .size-text {
    font-size: 14px;
    font-weight: 600;
  }

  .format-tag {
    font-size: 11px;
    padding: 3px 10px;
  }

  .quick-set-btn {
    height: 32px;
  }

  .disclaimer {
    margin-top: 24px;
    text-align: center;
    font-size: 13px;
    color: var(--color-muted);
  }
</style>

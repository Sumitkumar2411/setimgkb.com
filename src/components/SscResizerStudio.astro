---
// SscResizerStudio.astro — Dedicated SSC CHSL Photo & Signature Compressor
// Reuses the core binary-search canvas engine without duplicating logic.
---

<section class="ssc-studio-section w-full" aria-labelledby="ssc-studio-title">
  <h2 id="ssc-studio-title" class="sr-only">SSC CHSL Photo and Signature Resizer Studio</h2>

  <!-- Container Card with elevated depth -->
  <div class="w-full bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-5 sm:p-7 shadow-sm transition-all">

    <!-- Trust Signal Badge Pill -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800/80 text-xs">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full font-medium bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-800/70">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>✓ Meets SSC Portal Standards | Metadata &amp; EXIF Automatically Stripped</span>
      </div>

      <div class="inline-flex items-center gap-1.5 text-slate-500 dark:text-slate-400 font-mono text-[11px]">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
        100% Client-Side Engine
      </div>
    </div>

    <!-- Mode Switcher Bar (Segmented Tabs above Dropzone) -->
    <div class="mb-6">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5">
        Select SSC Document Type
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 p-1.5 bg-slate-100 dark:bg-slate-950/80 rounded-2xl border border-slate-200/80 dark:border-slate-800" role="tablist" aria-label="SSC Mode Selector">
        <!-- Photo Tab (Default) -->
        <button
          type="button"
          role="tab"
          id="tab-photo"
          aria-selected="true"
          aria-controls="ssc-mode-panel"
          class="ssc-tab active flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-semibold text-xs sm:text-sm transition-all cursor-pointer shadow-xs bg-white text-blue-700 dark:bg-slate-800 dark:text-blue-400 border border-slate-200/80 dark:border-slate-700 ring-2 ring-blue-500/20"
        >
          <svg class="w-4 h-4 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
          </svg>
          <div class="flex flex-col items-start leading-tight">
            <span>Passport Photo</span>
            <span class="text-[11px] font-normal text-slate-500 dark:text-slate-400">20KB – 50KB | 3.5 × 4.5 cm</span>
          </div>
        </button>

        <!-- Signature Tab -->
        <button
          type="button"
          role="tab"
          id="tab-signature"
          aria-selected="false"
          aria-controls="ssc-mode-panel"
          class="ssc-tab flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-semibold text-xs sm:text-sm transition-all cursor-pointer text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200"
        >
          <svg class="w-4 h-4 shrink-0 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <div class="flex flex-col items-start leading-tight">
            <span>Signature</span>
            <span class="text-[11px] font-normal text-slate-500 dark:text-slate-400">10KB – 20KB | 140 × 60 px</span>
          </div>
        </button>
      </div>
    </div>

    <!-- Active Mode Specification Overview Banner -->
    <div id="ssc-mode-panel" class="mb-6 p-4 rounded-2xl bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200/70 dark:border-blue-900/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      <div class="flex items-start gap-3">
        <div class="p-2 rounded-xl bg-blue-600 text-white shrink-0">
          <svg id="mode-icon-display" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span id="active-preset-title" class="font-bold text-slate-900 dark:text-white text-sm">
              SSC Passport Photo Preset Locked
            </span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
              Auto-Locked
            </span>
          </div>
          <p id="active-preset-desc" class="text-slate-600 dark:text-slate-400 mt-0.5">
            Dimensions locked to 3.5 × 4.5 cm (≈ 413 × 531 px @ 300 DPI) · Target ceiling: 50 KB (Safe corridor 47.5 – 49.0 KB).
          </p>
        </div>
      </div>

      <!-- Quick Specs Pill Counter -->
      <div class="flex sm:flex-col items-center sm:items-end justify-between gap-1 text-[11px] text-slate-500 dark:text-slate-400 border-t sm:border-t-0 pt-2 sm:pt-0 border-blue-200/50 dark:border-blue-900/40">
        <span class="font-medium">Target Ceiling: <strong id="spec-ceiling-badge" class="font-bold text-blue-700 dark:text-blue-400">50 KB</strong></span>
        <span class="font-medium">Notification Range: <strong id="spec-range-badge" class="font-bold text-slate-700 dark:text-slate-200">20 KB – 50 KB</strong></span>
      </div>
    </div>

    <!-- Dropzone Area -->
    <div
      id="ssc-dropzone"
      class="ssc-dropzone group relative border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 rounded-3xl p-8 sm:p-12 text-center transition-all cursor-pointer bg-slate-50/50 hover:bg-blue-50/20 dark:bg-slate-950/40 dark:hover:bg-slate-950/70"
      role="button"
      tabindex="0"
      aria-label="Upload photo or signature for SSC CHSL resizing"
    >
      <label for="ssc-file-input" class="w-full flex flex-col items-center cursor-pointer pointer-events-none">
        <div class="w-14 h-14 rounded-2xl bg-blue-100 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-xs" aria-hidden="true">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>

        <p class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-1">
          <span id="dropzone-action-text">Drop your SSC Passport Photo here</span>
        </p>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-4">
          JPG, JPEG, PNG, or WebP up to 25 MB · Instant in-browser binary downscaling
        </p>

        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 text-white shadow-xs group-hover:bg-blue-700 transition-colors">
          Browse File
        </span>

        <input
          type="file"
          id="ssc-file-input"
          accept="image/jpeg,image/png,image/webp"
          class="sr-only"
          aria-label="Choose image file for SSC resize"
        />
      </label>
    </div>

    <!-- Live Preset Control Bar (Locked Parameters Display) -->
    <div class="mt-6 pt-5 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-4 text-xs">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span id="lock-status-text">Preset Locked: SSC Passport Photo (3.5 × 4.5 cm | ≤ 50 KB)</span>
        </span>
        <span class="text-slate-400 dark:text-slate-600">•</span>
        <span id="lock-px-equivalent" class="font-mono text-slate-500 dark:text-slate-400 text-[11px]">
          Target Canvas: 413 × 531 px @ 300 DPI
        </span>
      </div>

      <!-- Signature Mode Toggle (Auto-toggled depending on tab, but candidate can fine tune) -->
      <label class="inline-flex items-center gap-2 cursor-pointer select-none text-slate-700 dark:text-slate-300 font-medium">
        <input type="checkbox" id="ssc-sig-enhancement" class="sr-only peer" />
        <span class="w-9 h-5 bg-slate-200 dark:bg-slate-700 peer-checked:bg-blue-600 rounded-full peer peer-focus:ring-2 peer-focus:ring-blue-500 transition-colors relative after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></span>
        <span class="text-xs">Signature Ink Enhancement</span>
      </label>
    </div>

    <!-- Progress / Processing Overlay -->
    <div id="ssc-progress-overlay" class="hidden my-6 p-6 rounded-2xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 text-center" aria-live="polite" aria-busy="true">
      <div class="inline-block animate-spin w-8 h-8 border-3 border-blue-600 border-t-transparent rounded-full mb-3" aria-hidden="true"></div>
      <p class="text-sm font-semibold text-slate-900 dark:text-white">Calculating SSC Binary Downsampling…</p>
      <p id="ssc-progress-hint" class="text-xs text-slate-500 dark:text-slate-400 mt-1">Convergence inside safe KB corridor</p>
    </div>

    <!-- Error Alert Box -->
    <div id="ssc-error-panel" class="hidden my-6 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs flex items-center gap-3" role="alert">
      <svg class="w-5 h-5 shrink-0 text-rose-600 dark:text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="ssc-error-message"></span>
    </div>

    <!-- Result & Split Comparison Preview Panel -->
    <div id="ssc-result-panel" class="hidden mt-8 pt-6 border-t border-slate-200/90 dark:border-slate-800/90">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>SSC Portal Optimized Output</span>
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
            ✓ 100% Portal Compliant
          </span>
        </h3>
        <span id="ssc-latency-tag" class="text-xs font-mono text-slate-500 dark:text-slate-400"></span>
      </div>

      <!-- Split Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-50/70 dark:bg-slate-950/50 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800">
        <!-- Original Card -->
        <div class="flex flex-col items-center text-center">
          <div class="w-full flex items-center justify-between mb-2 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <span>Uploaded Original</span>
            <span id="ssc-orig-dims" class="font-mono text-[11px] font-normal"></span>
          </div>
          <div class="w-full h-56 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 flex items-center justify-center p-2 overflow-hidden">
            <img id="ssc-orig-thumb" class="max-h-full max-w-full object-contain rounded-lg" alt="Original uploaded image" />
          </div>
          <div class="mt-3">
            <span id="ssc-orig-size" class="font-mono text-base font-bold text-slate-800 dark:text-slate-200">—</span>
          </div>
        </div>

        <!-- Optimized Card -->
        <div class="flex flex-col items-center text-center">
          <div class="w-full flex items-center justify-between mb-2 text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider">
            <span>SSC Compliant Output</span>
            <span id="ssc-out-dims" class="font-mono text-[11px] font-normal text-slate-500 dark:text-slate-400"></span>
          </div>
          <div class="w-full h-56 bg-white dark:bg-slate-900 rounded-xl border-2 border-blue-500/40 dark:border-blue-400/40 flex items-center justify-center p-2 overflow-hidden shadow-xs">
            <img id="ssc-out-thumb" class="max-h-full max-w-full object-contain rounded-lg" alt="Optimized SSC ready image" />
          </div>
          <div class="mt-3 flex items-center gap-2">
            <span id="ssc-out-size" class="font-mono text-base font-extrabold text-blue-600 dark:text-blue-400">—</span>
            <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold" id="ssc-safe-confirm"></span>
          </div>
        </div>
      </div>

      <!-- Action Row -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
        <button
          type="button"
          id="ssc-download-btn"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-700 text-white shadow-sm flex items-center justify-center gap-2.5 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span id="ssc-download-label">Download SSC Photo (JPG)</span>
        </button>

        <button
          type="button"
          id="ssc-reset-btn"
          class="w-full sm:w-auto px-4 py-2.5 rounded-xl font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
        >
          Reset &amp; Upload Another
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  // ── Mode Configurations according to Official SSC CHSL Notification ──
  type SscMode = 'photo' | 'signature';

  interface ModeConfig {
    name: string;
    targetKB: number;
    minKB: number;
    maxKB: number;
    unit: 'cm' | 'px';
    widthVal: number;
    heightVal: number;
    targetPxW: number;
    targetPxH: number;
    enhancementDefault: boolean;
    dropText: string;
    downloadPrefix: string;
    specsDesc: string;
    lockTitle: string;
  }

  // 300 DPI calculation:
  // 3.5 cm = Math.round((3.5 / 2.54) * 300) = 413 px
  // 4.5 cm = Math.round((4.5 / 2.54) * 300) = 531 px
  const SSC_CONFIGS: Record<SscMode, ModeConfig> = {
    photo: {
      name: 'Passport Photo',
      targetKB: 50, // Upper ceiling strictly enforced
      minKB: 20,
      maxKB: 50,
      unit: 'cm',
      widthVal: 3.5,
      heightVal: 4.5,
      targetPxW: 413,
      targetPxH: 531,
      enhancementDefault: false,
      dropText: 'Drop your SSC Passport Photo here',
      downloadPrefix: 'ssc-chsl-photo-50kb',
      specsDesc: 'Dimensions locked to 3.5 × 4.5 cm (≈ 413 × 531 px @ 300 DPI) · Target ceiling: 50 KB (Safe corridor 47.5 – 49.0 KB).',
      lockTitle: 'Preset Locked: SSC Passport Photo (3.5 × 4.5 cm | ≤ 50 KB)'
    },
    signature: {
      name: 'Signature',
      targetKB: 20, // Upper ceiling strictly enforced
      minKB: 10,
      maxKB: 20,
      unit: 'px',
      widthVal: 140,
      heightVal: 60,
      targetPxW: 140,
      targetPxH: 60,
      enhancementDefault: true,
      dropText: 'Drop your SSC Signature scan here',
      downloadPrefix: 'ssc-chsl-signature-20kb',
      specsDesc: 'Dimensions locked to 140 × 60 px (≈ 4.0 × 2.0 cm) · Target ceiling: 20 KB (Safe corridor 19.0 – 19.6 KB).',
      lockTitle: 'Preset Locked: SSC Signature (140 × 60 px | ≤ 20 KB)'
    }
  };

  // State
  let currentMode: SscMode = 'photo';
  let currentFile: File | null = null;
  let outputBlob: Blob | null = null;
  let worker: Worker | null = null;

  // DOM Elements
  const tabPhoto           = document.getElementById('tab-photo') as HTMLButtonElement;
  const tabSignature       = document.getElementById('tab-signature') as HTMLButtonElement;
  const activePresetTitle  = document.getElementById('active-preset-title')!;
  const activePresetDesc   = document.getElementById('active-preset-desc')!;
  const specCeilingBadge   = document.getElementById('spec-ceiling-badge')!;
  const specRangeBadge     = document.getElementById('spec-range-badge')!;
  const dropzoneActionText = document.getElementById('dropzone-action-text')!;
  const lockStatusText     = document.getElementById('lock-status-text')!;
  const lockPxEquivalent   = document.getElementById('lock-px-equivalent')!;
  const sigEnhancement     = document.getElementById('ssc-sig-enhancement') as HTMLInputElement;

  const dropzone           = document.getElementById('ssc-dropzone')!;
  const fileInput          = document.getElementById('ssc-file-input') as HTMLInputElement;
  const progressOverlay    = document.getElementById('ssc-progress-overlay')!;
  const progressHint       = document.getElementById('ssc-progress-hint')!;
  const errorPanel         = document.getElementById('ssc-error-panel')!;
  const errorMessage       = document.getElementById('ssc-error-message')!;
  const resultPanel        = document.getElementById('ssc-result-panel')!;

  const origThumb          = document.getElementById('ssc-orig-thumb') as HTMLImageElement;
  const origDims           = document.getElementById('ssc-orig-dims')!;
  const origSize           = document.getElementById('ssc-orig-size')!;
  const outThumb           = document.getElementById('ssc-out-thumb') as HTMLImageElement;
  const outDims            = document.getElementById('ssc-out-dims')!;
  const outSize            = document.getElementById('ssc-out-size')!;
  const safeConfirm        = document.getElementById('ssc-safe-confirm')!;
  const latencyTag         = document.getElementById('ssc-latency-tag')!;
  const downloadBtn        = document.getElementById('ssc-download-btn')!;
  const downloadLabel      = document.getElementById('ssc-download-label')!;
  const resetBtn           = document.getElementById('ssc-reset-btn')!;

  function fmtSize(bytes: number): string {
    if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    return `${(bytes / 1024).toFixed(1)} KB`;
  }

  function applyMode(mode: SscMode) {
    currentMode = mode;
    const cfg = SSC_CONFIGS[mode];

    // Update Tabs UI
    if (mode === 'photo') {
      tabPhoto.classList.add('active', 'bg-white', 'text-blue-700', 'dark:bg-slate-800', 'dark:text-blue-400', 'border', 'border-slate-200/80', 'dark:border-slate-700', 'ring-2', 'ring-blue-500/20', 'shadow-xs');
      tabPhoto.classList.remove('text-slate-600', 'dark:text-slate-400');
      tabPhoto.setAttribute('aria-selected', 'true');

      tabSignature.classList.remove('active', 'bg-white', 'text-blue-700', 'dark:bg-slate-800', 'dark:text-blue-400', 'border', 'border-slate-200/80', 'dark:border-slate-700', 'ring-2', 'ring-blue-500/20', 'shadow-xs');
      tabSignature.classList.add('text-slate-600', 'dark:text-slate-400');
      tabSignature.setAttribute('aria-selected', 'false');
    } else {
      tabSignature.classList.add('active', 'bg-white', 'text-blue-700', 'dark:bg-slate-800', 'dark:text-blue-400', 'border', 'border-slate-200/80', 'dark:border-slate-700', 'ring-2', 'ring-blue-500/20', 'shadow-xs');
      tabSignature.classList.remove('text-slate-600', 'dark:text-slate-400');
      tabSignature.setAttribute('aria-selected', 'true');

      tabPhoto.classList.remove('active', 'bg-white', 'text-blue-700', 'dark:bg-slate-800', 'dark:text-blue-400', 'border', 'border-slate-200/80', 'dark:border-slate-700', 'ring-2', 'ring-blue-500/20', 'shadow-xs');
      tabPhoto.classList.add('text-slate-600', 'dark:text-slate-400');
      tabPhoto.setAttribute('aria-selected', 'false');
    }

    // Update Presets UI
    activePresetTitle.textContent = `SSC ${cfg.name} Preset Locked`;
    activePresetDesc.textContent = cfg.specsDesc;
    specCeilingBadge.textContent = `${cfg.targetKB} KB`;
    specRangeBadge.textContent = `${cfg.minKB} KB – ${cfg.maxKB} KB`;
    dropzoneActionText.textContent = cfg.dropText;
    lockStatusText.textContent = cfg.lockTitle;
    lockPxEquivalent.textContent = `Target Canvas: ${cfg.targetPxW} × ${cfg.targetPxH} px`;
    sigEnhancement.checked = cfg.enhancementDefault;

    // If a file is already selected, re-compress under the new preset immediately
    if (currentFile) {
      runCompression(currentFile);
    }
  }

  // Tab click listeners
  tabPhoto.addEventListener('click', () => applyMode('photo'));
  tabSignature.addEventListener('click', () => applyMode('signature'));

  // Signature enhancement toggle change listener
  sigEnhancement.addEventListener('change', () => {
    if (currentFile) {
      runCompression(currentFile);
    }
  });

  // Drag & drop
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-blue-500', 'bg-blue-50/40', 'dark:bg-blue-950/20');
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-blue-500', 'bg-blue-50/40', 'dark:bg-blue-950/20');
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-blue-500', 'bg-blue-50/40', 'dark:bg-blue-950/20');
    const file = e.dataTransfer?.files[0];
    if (file) handleFile(file);
  });

  dropzone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
  });

  function showError(msg: string) {
    errorMessage.textContent = msg;
    errorPanel.classList.remove('hidden');
  }

  function hideError() {
    errorPanel.classList.add('hidden');
    errorMessage.textContent = '';
  }

  function handleFile(file: File) {
    const ALLOWED = ['image/jpeg', 'image/png', 'image/webp'];
    if (!ALLOWED.includes(file.type)) {
      showError('Unsupported format. Please upload a JPG, PNG, or WebP file for SSC processing.');
      return;
    }
    if (file.size > 25 * 1024 * 1024) {
      showError('File exceeds 25 MB limit. Please select a smaller photo or signature scan.');
      return;
    }

    currentFile = file;
    hideError();

    // Show original preview
    const url = URL.createObjectURL(file);
    origThumb.src = url;
    origThumb.onload = () => {
      origDims.textContent = `${origThumb.naturalWidth} × ${origThumb.naturalHeight} px`;
    };
    origSize.textContent = fmtSize(file.size);

    runCompression(file);
  }

  function runCompression(file: File) {
    const cfg = SSC_CONFIGS[currentMode];
    progressOverlay.classList.remove('hidden');
    resultPanel.classList.add('hidden');
    hideError();
    progressHint.textContent = `Auto-locking dimensions to ${cfg.targetPxW} × ${cfg.targetPxH} px and target ceiling to ${cfg.targetKB} KB…`;

    worker?.terminate();

    // Direct fallback using the imported compression engine
    const fallbackClientCompression = (f: File) => {
      import('../utils/compressionEngine')
        .then(({ compressImage }) => {
          compressImage({
            file: f,
            targetKB: cfg.targetKB,
            signatureMode: sigEnhancement.checked,
            customWidth: cfg.targetPxW,
            customHeight: cfg.targetPxH,
          })
            .then((result) => {
              progressOverlay.classList.add('hidden');
              showResult(result.blob, result.byteSize, result.width, result.height, result.latencyMs);
            })
            .catch((err) => {
              progressOverlay.classList.add('hidden');
              showError('Compression failed: ' + (err instanceof Error ? err.message : String(err)));
            });
        })
        .catch((err) => {
          progressOverlay.classList.add('hidden');
          showError('Failed to load compression module: ' + String(err));
        });
    };

    try {
      worker = new Worker(
        new URL('../workers/compress.worker.ts', import.meta.url),
        { type: 'module' }
      );
      worker.postMessage({
        file,
        targetKB: cfg.targetKB,
        signatureMode: sigEnhancement.checked,
        customWidth: cfg.targetPxW,
        customHeight: cfg.targetPxH,
      });

      worker.onmessage = (e) => {
        const { type, payload } = e.data;
        if (type === 'result') {
          const blob = new Blob([payload.arrayBuffer], { type: payload.mimeType });
          showResult(blob, payload.byteSize, payload.width, payload.height, payload.latencyMs);
        } else {
          fallbackClientCompression(file);
        }
        progressOverlay.classList.add('hidden');
      };

      worker.onerror = () => {
        fallbackClientCompression(file);
      };
    } catch {
      fallbackClientCompression(file);
    }
  }

  function showResult(blob: Blob, byteSize: number, width: number, height: number, latencyMs: number) {
    const cfg = SSC_CONFIGS[currentMode];
    outputBlob = blob;
    const url = URL.createObjectURL(blob);
    outThumb.src = url;
    outSize.textContent = fmtSize(byteSize);
    outDims.textContent = `${width} × ${height} px (${cfg.unit === 'cm' ? '3.5 × 4.5 cm' : '140 × 60 px'})`;
    latencyTag.textContent = `Processed in ${latencyMs} ms · 0 uploads`;
    safeConfirm.textContent = `✓ Within ${cfg.minKB}KB–${cfg.maxKB}KB SSC Window`;
    downloadLabel.textContent = `Download SSC ${cfg.name} (${fmtSize(byteSize)} JPG)`;
    resultPanel.classList.remove('hidden');

    setTimeout(() => {
      resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 120);
  }

  downloadBtn.addEventListener('click', () => {
    if (!outputBlob || !currentFile) return;
    const cfg = SSC_CONFIGS[currentMode];
    const a = document.createElement('a');
    a.href = URL.createObjectURL(outputBlob);
    a.download = `${cfg.downloadPrefix}.jpg`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10000);
  });

  resetBtn.addEventListener('click', () => {
    currentFile = null;
    outputBlob = null;
    worker?.terminate();
    worker = null;
    fileInput.value = '';
    resultPanel.classList.add('hidden');
    progressOverlay.classList.add('hidden');
    hideError();

    if (origThumb.src) URL.revokeObjectURL(origThumb.src);
    if (outThumb.src) URL.revokeObjectURL(outThumb.src);
    origThumb.src = '';
    outThumb.src = '';
  });
</script>

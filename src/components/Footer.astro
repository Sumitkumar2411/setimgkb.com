---
// Footer.astro — Unified Branding & Navigation Footer
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-950 py-12" role="contentinfo">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 pb-8 border-b border-slate-100 dark:border-slate-800/80 text-center md:text-left">
      <!-- Brand & Mission -->
      <div class="flex flex-col items-center md:items-start max-w-sm">
        <a href="/" class="flex items-center gap-2.5 text-slate-900 dark:text-white font-extrabold text-xl tracking-tight">
          <img src="/logo.png" alt="SetImgKB" class="w-8 h-8 shrink-0 object-contain rounded-lg" />
          SetImgKB
        </a>
        <p class="mt-2.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Deterministic client-side image compression for government portals, job exams, and competitive applications.
        </p>
        <div class="mt-3 inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
          100% In-Browser Execution
        </div>
      </div>

      <!-- Footer Navigation Grid -->
      <div class="grid grid-cols-2 gap-8 sm:gap-12 text-sm">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">Tools & Specs</h4>
          <ul class="space-y-2.5 text-slate-600 dark:text-slate-300 font-medium">
            <li>
              <a href="/#how-it-works" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">How it works</a>
            </li>
            <li>
              <a href="/#portal-specs" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Portal specs</a>
            </li>
            <li>
              <a href="/#faq" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Frequently Asked</a>
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">Trust & Legal</h4>
          <ul class="space-y-2.5 text-slate-600 dark:text-slate-300 font-medium">
            <li>
              <a href="/about-us" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">About Us</a>
            </li>
            <li>
              <a href="/privacy-policy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy Policy</a>
            </li>
            <li>
              <a href="/terms" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Terms of Service</a>
            </li>
            <li>
              <a href="/contact-us" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contact Us</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Centered Copyright -->
    <div class="pt-6 text-center text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; {currentYear} SetImgKB. Free in-browser utility. No accounts, no tracking.</p>
    </div>
  </div>
</footer>
